# Bounded backend test runtime; lock-aligned Python pins and public English OCR data only.
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr-eng=1:4.1.0-2 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir fastapi==0.141.1 starlette==1.7.0 pydantic==2.13.5 \
    pydantic-settings==2.15.0 SQLAlchemy==2.0.54 alembic==1.20.0 \
    psycopg[binary]==3.3.6 httpx==0.28.1 argon2-cffi==23.1.0 pymupdf==1.28.2
WORKDIR /validation/backend
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/validation/backend
